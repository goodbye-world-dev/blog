---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";

// The welcome post is pinned in the hero, so it stays out of the post list.
const WELCOME_POST_ID = "00-welcome";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const welcomePost = sortedPosts.find(({ id }) => id === WELCOME_POST_ID);
const latestPosts = sortedPosts.filter(({ id }) => id !== WELCOME_POST_ID);

if (!welcomePost) {
  throw new Error(
    `Welcome post "${WELCOME_POST_ID}" not found — update WELCOME_POST_ID in src/pages/index.astro.`
  );
}
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="app-layout">
    <section
      id="hero"
      class:list={["relative py-10 bg-background", "border-b border-border my-6"]}
    >
      <canvas
        id="hero-particles"
        class="pointer-events-none absolute inset-0 z-0 h-full w-full"
      ></canvas>
      <div class="relative z-10 px-6">
        <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
          The final commit is near.
        </h1>
        <p>
          AI is changing everything. It's changed me a bit too. Here you'll find a record of my adventures with AI — agent orchestration is the main theme, but what that means in practice, time will tell.
        </p>
        <p class="mt-2">
          Happy reading.
        </p>
        <p class="mt-2">
          New here? Start with <a href={getPath(welcomePost.id, welcomePost.filePath)} class="text-accent decoration-dashed underline-offset-4 hover:underline">{welcomePost.data.title}</a>.
        </p>
      </div>
    </section>

    {
      latestPosts.length > 0 && (
        <section id="latest-posts" class="pt-6 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Latest</h2>
          <ul>
            {latestPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Stretch the particle canvas beyond the max-w-3xl text column
     so dots appear on the left/right margins, not behind the text.
     Canvas is z-0; text wrapper is z-10 → text always on top.
     The section has isolation:isolate so the canvas z-index is
     scoped to the section stacking context, not the root. */
  #hero {
    position: relative;
    isolation: isolate;
  }
  #hero-particles {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-50vw + 50%);
    width: 100vw;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const canvas = document.getElementById(
      "hero-particles"
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const heroSection = document.getElementById("hero");
    if (!heroSection) return;

    let particlesArray: Particle[] = [];
    const mouse = {
      x: null as number | null,
      y: null as number | null,
      radius: 120,
    };

    function sizeCanvas() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
    }

    function getDotColor() {
      const isDark =
        document.documentElement.getAttribute("data-theme") === "dark";
      return isDark ? "rgba(99, 102, 241, 0.55)" : "rgba(0, 108, 172, 0.4)";
    }

    function getLineColor() {
      const isDark =
        document.documentElement.getAttribute("data-theme") === "dark";
      return isDark ? "rgba(99, 102, 241, 0.18)" : "rgba(0, 108, 172, 0.15)";
    }

    class Particle {
      x: number;
      y: number;
      dx: number;
      dy: number;
      size: number;
      constructor(x: number, y: number, dx: number, dy: number, size: number) {
        this.x = x;
        this.y = y;
        this.dx = dx;
        this.dy = dy;
        this.size = size;
      }
      draw() {
        if (!ctx) return;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2, false);
        ctx.fillStyle = getDotColor();
        ctx.fill();
      }
      update() {
        if (!canvas) return;
        if (this.x > canvas.width || this.x < 0) this.dx = -this.dx;
        if (this.y > canvas.height || this.y < 0) this.dy = -this.dy;
        this.x += this.dx;
        this.y += this.dy;

        if (mouse.x !== null && mouse.y !== null) {
          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouse.radius + this.size) {
            if (mouse.x < this.x && this.x < canvas.width - this.size * 10)
              this.x += 8;
            if (mouse.x > this.x && this.x > this.size * 10) this.x -= 8;
            if (mouse.y < this.y && this.y < canvas.height - this.size * 10)
              this.y += 8;
            if (mouse.y > this.y && this.y > this.size * 10) this.y -= 8;
          }
        }
        this.draw();
      }
    }

    function initParticles() {
      if (!canvas) return;
      particlesArray = [];
      if (window.innerWidth < 768) return;
      const numberOfParticles = (canvas.width * canvas.height) / 9000;
      for (let i = 0; i < numberOfParticles; i++) {
        const size = Math.random() * 2.5 + 1;
        const x = Math.random() * (canvas.width - size * 4) + size * 2;
        const y = Math.random() * (canvas.height - size * 4) + size * 2;
        const dx = Math.random() * 0.4 - 0.2;
        const dy = Math.random() * 0.4 - 0.2;
        particlesArray.push(new Particle(x, y, dx, dy, size));
      }
    }

    function connect() {
      if (!ctx || !canvas) return;
      const threshold = (canvas.width / 7) * (canvas.height / 7);
      for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a; b < particlesArray.length; b++) {
          const distSq =
            (particlesArray[a].x - particlesArray[b].x) ** 2 +
            (particlesArray[a].y - particlesArray[b].y) ** 2;
          if (distSq < threshold) {
            ctx.strokeStyle = getLineColor();
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(particlesArray[a].x, particlesArray[a].y);
            ctx.lineTo(particlesArray[b].x, particlesArray[b].y);
            ctx.stroke();
          }
        }
      }
    }

    // Clip canvas rendering to left/right margins only — keep text column clear.
    // The text column is max-w-3xl (768px) + px-4 padding (32px total), centered.
    const TEXT_COL = 768 + 32;
    function applyMarginClip() {
      if (!ctx || !canvas) return;
      const textLeft = Math.max(0, (canvas.width - TEXT_COL) / 2);
      const textRight = Math.min(canvas.width, textLeft + TEXT_COL);
      ctx.beginPath();
      ctx.rect(0, 0, textLeft, canvas.height); // left margin
      ctx.rect(textRight, 0, canvas.width - textRight, canvas.height); // right margin
      ctx.clip();
    }

    let rafId = 0;
    let paused = false;
    function animate() {
      rafId = requestAnimationFrame(animate);
      if (paused || !ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (window.innerWidth < 768) return;
      ctx.save();
      applyMarginClip();
      for (let i = 0; i < particlesArray.length; i++)
        particlesArray[i].update();
      connect();
      ctx.restore();
    }

    const toggleBtn = document.getElementById("particles-toggle");
    toggleBtn?.addEventListener("click", () => {
      paused = !paused;
      if (toggleBtn) {
        toggleBtn.textContent = paused ? "▶" : "⏸";
        toggleBtn.title = paused
          ? "Play background animation"
          : "Pause background animation";
        toggleBtn.setAttribute("aria-label", toggleBtn.title);
      }
      if (!paused && ctx && canvas) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    });

    function onMouseMove(e: MouseEvent) {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    }
    function onMouseLeave() {
      mouse.x = null;
      mouse.y = null;
    }
    function onResize() {
      sizeCanvas();
      initParticles();
    }

    sizeCanvas();
    initParticles();
    if (window.innerWidth >= 768) {
      animate();
      window.addEventListener("mousemove", onMouseMove);
      window.addEventListener("mouseleave", onMouseLeave);
    }
    window.addEventListener("resize", onResize);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(rafId);
        window.removeEventListener("mousemove", onMouseMove);
        window.removeEventListener("mouseleave", onMouseLeave);
        window.removeEventListener("resize", onResize);
      },
      { once: true }
    );
  });
</script>
